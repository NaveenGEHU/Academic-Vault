<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="0dp"
    tools:context=".add_Document">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="10dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="3dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="5dp">

            <TextView
                android:id="@+id/headerText"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="7dp"
                android:background="@color/white"
                android:gravity="left|center_vertical"
                android:padding="5dp"
                android:text="Upload Documnet"
                android:textColor="@color/black"
                android:textSize="21sp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="20dp"
            android:padding="8dp"
            android:text="Add a new document to  to subject"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/uploadDocBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:background="@color/white"
            android:foreground="@drawable/dashed_border"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:id="@+id/uploadInnerLayout"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/uploadIcon"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="50dp"
                    android:padding="15dp"
                    app:srcCompat="@drawable/icon_upload" />

                <TextView
                    android:id="@+id/uploadInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingBottom="18dp"
                    android:text="Tap to select document"
                    android:textColor="@color/black"
                    android:textSize="17sp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"
            android:background="@color/white"
            android:foreground="@drawable/solid_border"
            android:outlineProvider="none"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="15dp">

            <EditText
                android:id="@+id/docTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#00FFFFFF"
                android:gravity="center|left"
                android:hint="Document Title*"
                android:inputType="text"
                android:padding="5dp"
                android:textColor="@color/black"
                android:textColorHint="#858282"
                android:textSize="18sp" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/typeCard"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="12dp"
            android:background="@color/white"
            android:foreground="@drawable/solid_border"
            android:outlineProvider="none"
            android:padding="0dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="15dp">

            <Spinner
                android:id="@+id/docTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:entries="@array/doctype"
                android:spinnerMode="dropdown" />

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/finalUploadBtn"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="12dp"
            android:text="Upload Document"
            android:textColor="#FBFAFA"
            android:textColorLink="#AB3232"
            android:textSize="20sp"
            app:cornerRadius="9dp"
            app:rippleColor="@color/black" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>